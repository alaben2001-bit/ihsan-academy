{
  "name": "academy-build-human",
  "version": "63.0.0",
  "private": true,
  "description": "أكاديمية الإحسان في بناء الإنسان — V63 (student lesson practice and feedback)",
  "scripts": {
    "start": "node server/server.js",
    "backup": "node tools/backup-db.js",
    "restore": "node tools/restore-db.js",
    "export:production": "node tools/export-production-sql.js",
    "migrate:sqlite": "node tools/migrate-json-sqlite.js",
    "migrate:json": "node tools/migrate-sqlite-json.js",
    "health:storage": "node tools/health-storage.js",
    "migrate:core": "node tools/migrate-core-v31.js",
    "verify:core": "node tools/verify-core-v31.js",
    "migrate:postgres": "node tools/migrate-json-postgres.js",
    "health:postgres": "node tools/health-postgres.js",
    "backup:postgres": "node tools/backup-postgres.js",
    "restore:postgres": "node tools/restore-postgres.js",
    "migrations:postgres": "node tools/migrations-postgres.js",
    "migrations:postgres:status": "node tools/migrations-postgres.js --status",
    "backup:scheduler": "node tools/backup-scheduler.js",
    "backup:verify": "node tools/verify-backups.js",
    "prod:compose": "docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --build",
    "test": "node --check server/server.js && node --check server/advanced.js && node --check server/educational-content.js && node --check assets/app.js && node tests/smoke.js && node tests/educational-content.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
