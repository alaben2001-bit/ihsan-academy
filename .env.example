# أكاديمية الإحسان — إعدادات الإنتاج/التطوير
ACADEMY_DB_MODE=local
ACADEMY_STORAGE=json
ACADEMY_CLOUD_URL=
ACADEMY_CLOUD_KEY=
PORT=3000
ACADEMY_DB_FILE=
# مدة الجلسة بالساعات (افتراضي 12)
ACADEMY_SESSION_TTL_HOURS=12
# الحد الأقصى التقريبي للطلبات من عنوان واحد في الدقيقة
ACADEMY_RATE_LIMIT_PER_MINUTE=240

# يُستخدم فقط لإنشاء المدير الأول إذا لم يوجد أي مدير في قاعدة البيانات
# يجب أن تكون كلمة المرور 12 محرفًا على الأقل
ACADEMY_BOOTSTRAP_ADMIN_NAME=مدير أكاديمية الإحسان
ACADEMY_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ACADEMY_BOOTSTRAP_ADMIN_PASSWORD=ضع-كلمة-مرور-قوية-هنا
