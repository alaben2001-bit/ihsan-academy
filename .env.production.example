NODE_ENV=production
ACADEMY_PRODUCTION=1
ACADEMY_REQUIRE_HTTPS=1
PORT=443
ACADEMY_STORAGE=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/academy
ACADEMY_PG_SSL=1
ACADEMY_PG_SSL_VERIFY=1
ACADEMY_TLS_CERT_FILE=/etc/letsencrypt/live/example/fullchain.pem
ACADEMY_TLS_KEY_FILE=/etc/letsencrypt/live/example/privkey.pem
ACADEMY_SESSION_TTL_HOURS=12
ACADEMY_RATE_LIMIT_PER_MINUTE=240
ACADEMY_COOKIE_SECURE=1
