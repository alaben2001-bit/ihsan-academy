{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ihsan-academy-students-free",
  "main": "src/index.js",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ihsan-academy-students",
      "database_id": "33123c73-73a0-4eba-9b48-d3ed5ac92266",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "GOOGLE_CLIENT_ID": "641495662203-4binlb6m78b7p1rqtb68rlc4pqv3d8oo.apps.googleusercontent.com"
  }
}
