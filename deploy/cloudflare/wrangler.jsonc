{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ihsan-academy-students-free",
  "main": "src/index.js",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ihsan-academy-students",
      "database_id": "33123c73-73a0-4eba-9b48-d3ed5ac92266",
      "migrations_dir": "migrations"
    }
  ],
  // النسخ الاحتياطي المجدول: بعد تفعيل R2 من لوحة Cloudflare (خطوة لمرة واحدة،
  // R2 غير مفعّل حالياً في الحساب) أزل التعليق عن المقطعين التاليين ثم انشر.
  // الكود جاهز في src/index.js (scheduled + buildFullBackup) ويعمل محلياً.
  // "r2_buckets": [
  //   {
  //     "binding": "BACKUPS",
  //     "bucket_name": "ihsan-academy-backups"
  //   }
  // ],
  // "triggers": {
  //   "crons": [
  //     "0 3 * * *"
  //   ]
  // },
  "vars": {
    "APP_ENV": "production",
    "GOOGLE_CLIENT_ID": "641495662203-cbem2epiq8031681kddo1jgqog3clesi.apps.googleusercontent.com"
  }
}
