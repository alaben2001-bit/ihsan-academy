{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ihsan-academy-students-free",
  "main": "src/index.js",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ihsan-academy-students",
      "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production"
  }
}
