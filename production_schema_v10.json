  "security_rules": [
    "Never trust role or student_id from the browser; derive them from the authenticated session.",
    "A student can read only their own private profile/progress.",
    "A parent can read only linked children.",
    "A teacher can read/update only students in assigned groups.",
    "An admin can manage academy-wide records.",
    "Public clients never receive service-role/admin database keys."
